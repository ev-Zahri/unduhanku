{
    "name": "ramad/unduhanmu",
    "description": "Website downloader all social media such as image, video, audio, etc.",
    "type": "project",
    "authors": [
        {
            "name": "zahri",
            "email": "zrimrnid@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php -l src/",
        "check-style": "phpcs --standard=PSR12 src/",
        "fix-style": "phpcbf --standard=PSR12 src/",
        "analyze": "phpstan analyze src/",

        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --coverage-html build/coverage",

        "build": [
            "composer install --no-dev --optimize-autoloader",
            "echo 'Aplikasi siap didistribusi tanpa dependency development'"
        ],
        "deploy:staging": [
            "@build",
            "rsync -avz --exclude-from=.deployignore . user@staging-server:/var/www/app"
        ],
        "ready": [
            "@lint",
            "@analyze",
            "@test"
        ]
    }
}
